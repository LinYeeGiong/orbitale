---
import { getCollection } from 'astro:content';
import SiteShell from '../../layouts/SiteShell.astro';
import { getContentPath, isPublishedChinese } from '../../lib/content';

const entries = (await getCollection('notes', isPublishedChinese)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SiteShell title="学习记录">
  <main class="page-main">
    <header class="page-heading"><span>02 / NOTES</span><h1>学习记录</h1></header>
    <section class="content-list" aria-label="学习记录列表">
      {entries.map((entry) => <article class="content-row"><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('zh-CN')}</time><a class="content-copy" href={getContentPath('notes', entry.id)}><h2>{entry.data.title}</h2><p>{entry.data.description}</p></a><small>{entry.data.readingMinutes ?? 5} MIN ↗</small></article>)}
    </section>
  </main>
</SiteShell>
