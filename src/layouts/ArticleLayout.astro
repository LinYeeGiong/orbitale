---
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '../config/site';
import { getContentPath, type ContentKind, type ContentRecord } from '../lib/content';
import SiteShell from './SiteShell.astro';

type ArticleEntry = CollectionEntry<'notes'> | CollectionEntry<'essays'> | CollectionEntry<'daily'>;

interface Props {
  entry: ArticleEntry;
  kind: ContentKind;
  previous: ContentRecord | null;
  next: ContentRecord | null;
}

const { entry, kind, previous, next } = Astro.props;
const kindMeta = {
  notes: { eyebrow: 'LEARNING NOTES', back: '返回学习记录', label: '笔记' },
  essays: { eyebrow: 'ESSAYS', back: '返回随笔', label: '随笔' },
  daily: { eyebrow: 'DAILY', back: '返回生活切片', label: 'Daily' },
} as const;
const meta = kindMeta[kind];
const path = getContentPath(kind, entry.id);
const canonical = new URL(path, Astro.site ?? Astro.url.origin).href;
const publishedTime = entry.data.date.toISOString();
const formattedDate = entry.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: publishedTime,
  inLanguage: entry.data.lang,
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
  },
};
---

<SiteShell
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  ogType="article"
  publishedTime={publishedTime}
  jsonLd={jsonLd}
>
  <main class="article-main" id="top">
    <a class="article-back" href={`/${kind}/`}>← {meta.back}</a>
    <article data-article-kind={kind}>
      <header class="article-header">
        <div class="article-meta"><span>{meta.eyebrow}</span><time datetime={publishedTime}>{formattedDate}</time></div>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
        <div class="article-tags" aria-label="文章标签">
          {entry.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </header>

      <div class="article-body">
        <slot />
      </div>

      <footer class="article-actions">
        <div class="permalink">
          <a href={canonical} data-canonical-link>永久链接</a>
          <button type="button" data-copy-link data-url={canonical}>复制链接</button>
        </div>
        <nav class="article-adjacent" aria-label="相邻文章">
          {previous ? <a href={getContentPath(previous.kind, previous.id)}><small>上一篇</small><span>{previous.title}</span></a> : <span></span>}
          {next ? <a href={getContentPath(next.kind, next.id)}><small>下一篇</small><span>{next.title}</span></a> : <span></span>}
        </nav>
      </footer>
    </article>
  </main>
</SiteShell>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        button.textContent = '已复制';
        window.setTimeout(() => { button.textContent = '复制链接'; }, 1200);
      } catch {
        window.location.hash = 'top';
      }
    });
  });
</script>

<style>
  .article-main { position: relative; z-index: 1; max-width: 840px; margin: 0 auto; padding: 42px 0 84px; }
  .article-back { display: inline-flex; margin-bottom: 52px; color: var(--muted); font: 400 11px 'DM Mono', monospace; }
  .article-back:hover { color: var(--cyan); }
  .article-header { padding-bottom: 34px; border-bottom: 1px solid var(--line); }
  .article-meta { display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font: 400 11px 'DM Mono', monospace; }
  .article-meta span { color: var(--coral); letter-spacing: .08em; }
  .article-header h1 { max-width: 760px; margin: 24px 0 18px; font: 600 clamp(38px, 7vw, 64px)/1.12 'Noto Serif SC', serif; letter-spacing: 0; }
  .article-header > p { max-width: 650px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .article-tags { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 24px; color: var(--cyan); font: 400 10px 'DM Mono', monospace; }
  .article-tags a:hover { color: var(--coral); }
  .article-body { padding: 42px 0 54px; font-size: 16px; line-height: 1.9; }
  .article-body :global(h2), .article-body :global(h3), .article-body :global(h4) { margin: 2em 0 .75em; font-family: 'Noto Serif SC', serif; line-height: 1.35; letter-spacing: 0; }
  .article-body :global(h2) { font-size: 28px; }
  .article-body :global(h3) { font-size: 22px; }
  .article-body :global(p), .article-body :global(ul), .article-body :global(ol), .article-body :global(blockquote), .article-body :global(pre), .article-body :global(table), .article-body :global(figure) { margin: 0 0 1.45em; }
  .article-body :global(a) { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
  .article-body :global(blockquote) { padding: 16px 20px; border-left: 3px solid var(--coral); background: var(--panel); color: var(--muted); }
  .article-body :global(code) { padding: 2px 5px; border-radius: 3px; background: var(--soft); color: var(--yellow); font: 400 .88em 'DM Mono', monospace; }
  .article-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 18px; border: 1px solid var(--line); background: var(--panel); }
  .article-body :global(pre code) { padding: 0; background: transparent; color: var(--ink); }
  .article-body :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; }
  .article-body :global(th), .article-body :global(td) { padding: 10px 12px; border: 1px solid var(--line); text-align: left; }
  .article-body :global(img) { display: block; max-width: 100%; height: auto; margin: 28px auto; }
  .article-body :global(figcaption) { color: var(--muted); font-size: 12px; text-align: center; }
  .article-actions { padding-top: 24px; border-top: 1px solid var(--line); }
  .permalink { display: flex; align-items: center; justify-content: flex-end; gap: 10px; font: 400 10px 'DM Mono', monospace; }
  .permalink a { color: var(--muted); }
  .permalink button { border: 1px solid var(--line); border-radius: 3px; background: var(--panel); color: var(--ink); padding: 7px 10px; }
  .permalink button:hover { border-color: var(--cyan); color: var(--cyan); }
  .article-adjacent { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 34px; }
  .article-adjacent a { min-width: 0; padding: 16px 0; border-top: 1px solid var(--line); }
  .article-adjacent a:last-child { text-align: right; }
  .article-adjacent small { display: block; margin-bottom: 7px; color: var(--muted); font: 400 9px 'DM Mono', monospace; }
  .article-adjacent span { font: 500 15px 'Noto Serif SC', serif; }
  .article-adjacent a:hover span { color: var(--coral); }
  @media (max-width: 720px) { .article-main { padding: 30px 0 62px; } .article-back { margin-bottom: 36px; } .article-meta { align-items: flex-start; flex-direction: column; gap: 8px; } .article-body { font-size: 15px; } }
  @media (max-width: 520px) { .article-adjacent { grid-template-columns: 1fr; gap: 10px; } .article-adjacent a:last-child { text-align: left; } .permalink { justify-content: space-between; } }
</style>
